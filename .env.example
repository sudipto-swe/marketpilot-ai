# Application
PROJECT_NAME="MarketPilot AI"
VERSION="1.0.0"

# Security
SECRET_KEY="marketpilot-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: SQLite local-first, PostgreSQL production-ready)
DATABASE_URL="sqlite:///./marketpilot.db"

# AI Inference Provider ('mock' or 'ollama')
LLM_PROVIDER="mock"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3:8b"
